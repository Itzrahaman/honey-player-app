<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left stem of H (Pill shape) -->
    <path
        android:pathData="M 33,28 L 37,28 A 5,5 0 0 1 42,33 L 42,75 A 5,5 0 0 1 37,80 L 33,80 A 5,5 0 0 1 28,75 L 28,33 A 5,5 0 0 1 33,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="42"
                android:endY="80"
                android:type="linear">
                <item android:color="#FFD54F" android:offset="0.0" />
                <item android:color="#FFB300" android:offset="0.5" />
                <item android:color="#FFA000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center H-bridge connecting stem to Play head -->
    <path
        android:pathData="M 42,49 L 49,49 L 49,59 L 42,59 Z"
        android:fillColor="#FFB300" />

    <!-- Play Head Upper Facet (H right branch + top play triangle) -->
    <path
        android:pathData="M 49,33 C 49,29.5 52.8,27.3 55.8,29.1 L 78.4,52.3 C 79.6,53.3 79.6,54.7 78.4,55.7 L 49,55.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="49"
                android:startY="28"
                android:endX="80"
                android:endY="54"
                android:type="linear">
                <item android:color="#FFE082" android:offset="0.0" />
                <item android:color="#FFCA28" android:offset="0.4" />
                <item android:color="#FFB300" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play Head Lower Facet (H right branch + bottom play triangle) -->
    <path
        android:pathData="M 49,53 L 78.4,52.3 C 79.6,53.3 79.6,54.7 78.4,55.7 L 55.8,78.9 C 52.8,80.7 49,78.5 49,75 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="49"
                android:startY="54"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:color="#FFB300" android:offset="0.0" />
                <item android:color="#FFA000" android:offset="0.6" />
                <item android:color="#FF8F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Honey Bevel Highlight on the bridge seam -->
    <path
        android:pathData="M 42,49 L 49,49 L 49,50 L 42,50 Z"
        android:fillColor="#FFF8E1" />

</vector>
